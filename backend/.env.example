# ─── SmartOps Backend Environment Variables ───────────────────────────────────
PORT=5000
MONGO_URI=mongodb://localhost:27017/smartops

# ─── Email SMTP Configuration (Optional) ───────────────────────────────────────
# By default, SmartOps runs in Dev / Simulation Mode:
# When no SMTP credentials are provided, OTP codes are logged in the server terminal
# and automatically returned to the registration UI for instant verification.
#
# To enable real email delivery through Gmail, uncomment and set your credentials:
# (Note: EMAIL_PASS must be a 16-character Google App Password, not your regular password)
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_16_digit_app_password
# EMAIL_FROM="SmartOps Security" <your_email@gmail.com>
